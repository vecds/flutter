class ImplicitAnimationDemo extends StatefulWidget {
  const ImplicitAnimationDemo({super.key});

  @override
  State<ImplicitAnimationDemo> createState() => _ImplicitAnimationDemoState();
}

class _ImplicitAnimationDemoState extends State<ImplicitAnimationDemo> {
  // State variable driving the layout properties
  bool _isExpanded = false;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Implicit Animation'),
        centerTitle: true,
      ),
      body: Center(
        child: GestureDetector(
          onTap: () {
            // Trigger state change to auto-start the interpolation
            setState(() {
              _isExpanded = !_isExpanded;
            });
          },
          // AnimatedContainer automatically interpolates decoration and size shifts
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 500),
            curve: Curves.easeInOut,
            width: _isExpanded ? 300.0 : 100.0,
            height: _isExpanded ? 100.0 : 100.0,
            decoration: BoxDecoration(
              color: _isExpanded ? Colors.deepPurple : Colors.blue,
              borderRadius: BorderRadius.circular(_isExpanded ? 24.0 : 8.0),
              // Optional: Enhancing visual depth during expansion
              boxShadow: [
                BoxShadow(
                  color: Colors.black26,
                  blurRadius: _isExpanded ? 12.0 : 4.0,
                  offset: const Offset(0, 4),
                ),
              ],
            ),
            child: const Center(
              child: Text(
                'Tap Me',
                style: TextStyle(
                  color: Colors.white,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
}


EXPLICIT ANIMATIONS:

import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        body: Center(
          child: PulseButton(),
        ),
      ),
    );
  }
}

class PulseButton extends StatefulWidget {
  const PulseButton({super.key});

  @override
  State<PulseButton> createState() => _PulseButtonState();
}

class _PulseButtonState extends State<PulseButton>
    with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _animation;

  @override
  void initState() {
    super.initState();

    // 1. Initialize the controller to repeat indefinitely
    _controller = AnimationController(
      duration: const Duration(seconds: 2),
      vsync: this,
    );

    // 2. Define the size scale scale variance (from 100% to 115%)
    _animation = Tween<double>(begin: 1.0, end: 1.15).animate(
      CurvedAnimation(parent: _controller, curve: Curves.easeInOut),
    );

    // 3. Make the animation loop back and forth automatically
    _controller.repeat(reverse: true);
  }

  @override
  void dispose() {
    _controller.dispose(); // Always clear controller resources
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return ScaleTransition(
      scale: _animation,
      child: Container(
        width: 100,
        height: 100,
        decoration: BoxDecoration(
          color: Colors.red,
          shape: BoxShape.circle,
          boxShadow: [
            BoxShadow(
              color: Colors.red.withOpacity(0.5),
              blurRadius: 20,
              spreadRadius: 10,
            ),
          ],
        ),
        child: const Icon(
          Icons.mic,
          color: Colors.white,
          size: 40,
        ),
      ),
    );
  }
}


b) Experiment with different types of animations (fade, slide, etc.)

import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Implicit Animation Demo',
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepPurple),
        useMaterial3: true,
      ),
      home: const FadeAndSlideDemo(),
    );
  }
}

class FadeAndSlideDemo extends StatefulWidget {
  const FadeAndSlideDemo({super.key});

  @override
  State<FadeAndSlideDemo> createState() => _FadeAndSlideDemoState();
}

class _FadeAndSlideDemoState extends State<FadeAndSlideDemo> {
  // State variable to track visibility
  bool _isVisible = false;

  void _toggleAnimation() {
    setState(() {
      _isVisible = !_isVisible;
    });
  }

  @override
  Widget build(BuildContext context) {
    const animationDuration = Duration(milliseconds: 600);
    const animationCurve = Curves.easeInOutCubic;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Fade & Slide Animation'),
        backgroundColor: Theme.of(context).colorScheme.inversePrimary,
      ),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            // Outer implicit animation handling vertical offset position
            AnimatedSlide(
              offset: _isVisible ? const Offset(0, 0) : const Offset(0, 0.4),
              duration: animationDuration,
              curve: animationCurve,
              // Inner implicit animation handling transparency layers
              child: AnimatedOpacity(
                opacity: _isVisible ? 1.0 : 0.0,
                duration: animationDuration,
                curve: animationCurve,
                child: Container(
                  width: 200,
                  height: 200,
                  decoration: BoxDecoration(
                    color: Theme.of(context).colorScheme.primary,
                    borderRadius: BorderRadius.circular(24),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withAlpha(25),
                        blurRadius: 20,
                        offset: const Offset(0, 10),
                      )
                    ],
                  ),
                  child: const Center(
                    child: Text(
                      'Surprise! 🎉',
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 24,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ),
              ),
            ),
            const SizedBox(height: 60),
            FilledButton.icon(
              onPressed: _toggleAnimation,
              icon: Icon(_isVisible ? Icons.visibility_off : Icons.visibility),
              label: Text(_isVisible ? 'Hide Content' : 'Show Content'),
            ),
          ],
        ),
      ),
    );
  }
}

